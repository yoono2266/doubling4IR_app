+            <a
+              href={mailtoHref}
+              className="w-full py-3 rounded-xl gold-button-gradient text-[#0D1B2A] font-extrabold text-sm flex items-center justify-center gap-2 hover:brightness-110 active:scale-[0.98] transition"
+            >
