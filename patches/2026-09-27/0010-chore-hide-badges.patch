-                    #{idx + 2} {jp.badge || ''}
+                    #{idx + 2} {SHOW_BADGES ? (jp.badge || '') : ''}
                   </span>
                   <span className="text-[9px] text-slate-400 font-mono">
                     {((jp.amountUsd / totalJackpotSum) * 100).toFixed(0)}%
