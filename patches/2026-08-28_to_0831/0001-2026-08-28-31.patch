+  reward: number; // 지급 DP
+}
+
+export const STREAK_MILESTONES: StreakMilestone[] = [
+  { days: 3, reward: 100 },
+  { days: 7, reward: 250 },
+  { days: 14, reward: 500 },
+  { days: 30, reward: 1500 },
