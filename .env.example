PORT=3000
NODE_ENV=development
# Web OAuth client ID used by the Google Sign-In JS plugin and plugin.initialize().
VITE_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Backward compatibility: old variable name kept temporarily.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Android package + SHA-1 is configured in Google Cloud Console/Firebase, not passed here.
